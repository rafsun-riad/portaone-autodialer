# The Next.js server should call the backend over localhost when both are running on the same machine.
BACKEND_API_ORIGIN=http://localhost:8000

# Allow Cloudflare tunnel hostnames to request Next.js dev assets and endpoints.
NEXT_ALLOWED_DEV_ORIGINS=*.trycloudflare.com

# Keep a public backend URL here only if you need a browser-visible origin later.
NEXT_PUBLIC_BACKEND_API_ORIGIN=https://your-backend-tunnel.trycloudflare.com

# This project currently proxies external-system work through the backend, so this can stay local
# unless you intentionally add direct browser-side calls later.
EXTERNAL_SYSTEM_ORIGIN=http://localhost:8080
NEXT_PUBLIC_EXTERNAL_SYSTEM_ORIGIN=http://localhost:8080